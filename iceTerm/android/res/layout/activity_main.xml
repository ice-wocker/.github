<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D1117"
    android:fitsSystemWindows="true">

    <!-- Top Status & Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:background="#161B22"
        android:gravity="center_vertical"
        android:paddingLeft="10dp"
        android:paddingRight="10dp">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="iceTerm"
            android:textColor="#58A6FF"
            android:textStyle="bold"
            android:textSize="14sp"
            android:fontFamily="monospace" />

        <Button
            android:id="@+id/btn_ai"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="AI"
            android:textSize="11sp"
            android:textColor="#C9D1D9"
            android:background="#21262D"
            android:fontFamily="monospace"
            android:minWidth="48dp"
            android:layout_marginRight="4dp" />

        <Button
            android:id="@+id/btn_radar"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="RADAR"
            android:textSize="11sp"
            android:textColor="#C9D1D9"
            android:background="#21262D"
            android:fontFamily="monospace"
            android:minWidth="56dp"
            android:layout_marginRight="4dp" />

        <Button
            android:id="@+id/btn_status"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="SYS"
            android:textSize="11sp"
            android:textColor="#C9D1D9"
            android:background="#21262D"
            android:fontFamily="monospace"
            android:minWidth="48dp"
            android:layout_marginRight="4dp" />

        <Button
            android:id="@+id/btn_clear"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="CLR"
            android:textSize="11sp"
            android:textColor="#C9D1D9"
            android:background="#21262D"
            android:fontFamily="monospace"
            android:minWidth="48dp" />
    </LinearLayout>

    <!-- Terminal Display Output -->
    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:fillViewport="true"
        android:background="#090D13">

        <TextView
            android:id="@+id/term_output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#C9D1D9"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:lineSpacingExtra="2dp" />
    </ScrollView>

    <!-- Virtual Keyboard Helper Bar -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="#161B22"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layout_extra_keys"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="6dp"
            android:paddingRight="6dp">

            <Button
                android:id="@+id/btn_key_ctrl_c"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="^C"
                android:textSize="11sp"
                android:textColor="#F85149"
                android:background="#21262D"
                android:fontFamily="monospace"
                android:minWidth="40dp"
                android:layout_marginRight="4dp" />

            <Button
                android:id="@+id/btn_key_tab"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="TAB"
                android:textSize="11sp"
                android:textColor="#C9D1D9"
                android:background="#21262D"
                android:fontFamily="monospace"
                android:minWidth="42dp"
                android:layout_marginRight="4dp" />

            <Button
                android:id="@+id/btn_key_esc"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="ESC"
                android:textSize="11sp"
                android:textColor="#C9D1D9"
                android:background="#21262D"
                android:fontFamily="monospace"
                android:minWidth="42dp"
                android:layout_marginRight="4dp" />

            <Button
                android:id="@+id/btn_key_pipe"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="|"
                android:textSize="12sp"
                android:textColor="#58A6FF"
                android:background="#21262D"
                android:fontFamily="monospace"
                android:minWidth="32dp"
                android:layout_marginRight="4dp" />

            <Button
                android:id="@+id/btn_key_tilde"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="~"
                android:textSize="12sp"
                android:textColor="#C9D1D9"
                android:background="#21262D"
                android:fontFamily="monospace"
                android:minWidth="32dp"
                android:layout_marginRight="4dp" />

            <Button
                android:id="@+id/btn_key_slash"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="/"
                android:textSize="12sp"
                android:textColor="#C9D1D9"
                android:background="#21262D"
                android:fontFamily="monospace"
                android:minWidth="32dp"
                android:layout_marginRight="4dp" />

            <Button
                android:id="@+id/btn_key_dash"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="-"
                android:textSize="12sp"
                android:textColor="#C9D1D9"
                android:background="#21262D"
                android:fontFamily="monospace"
                android:minWidth="32dp"
                android:layout_marginRight="4dp" />

            <Button
                android:id="@+id/btn_key_up"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="UP"
                android:textSize="11sp"
                android:textColor="#C9D1D9"
                android:background="#21262D"
                android:fontFamily="monospace"
                android:minWidth="36dp"
                android:layout_marginRight="4dp" />

            <Button
                android:id="@+id/btn_key_down"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="DOWN"
                android:textSize="11sp"
                android:textColor="#C9D1D9"
                android:background="#21262D"
                android:fontFamily="monospace"
                android:minWidth="48dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Command Input Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="#161B22"
        android:gravity="center_vertical"
        android:paddingLeft="8dp"
        android:paddingRight="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$ "
            android:textColor="#3FB950"
            android:textStyle="bold"
            android:textSize="14sp"
            android:fontFamily="monospace" />

        <EditText
            android:id="@+id/term_input"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="#0D1117"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:singleLine="true"
            android:imeOptions="actionDone"
            android:hint="input command..."
            android:textColorHint="#484F58" />

        <Button
            android:id="@+id/btn_send"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="RUN"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:background="#238636"
            android:fontFamily="monospace"
            android:minWidth="52dp"
            android:layout_marginLeft="6dp" />
    </LinearLayout>

</LinearLayout>
