<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_terminal"
    android:fitsSystemWindows="true">

    <!-- Top Action Toolbar -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@color/bg_bar"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="8dp"
            android:paddingRight="8dp">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="iceTerm"
                android:textColor="@color/accent_blue"
                android:textStyle="bold"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:layout_marginRight="10dp" />

            <Button
                android:id="@+id/btn_ai"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="@string/btn_ai"
                android:textSize="11sp"
                android:textColor="@color/btn_text"
                android:background="@color/bg_btn"
                android:fontFamily="monospace"
                android:layout_marginRight="4dp" />

            <Button
                android:id="@+id/btn_radar"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="@string/btn_radar"
                android:textSize="11sp"
                android:textColor="@color/btn_text"
                android:background="@color/bg_btn"
                android:fontFamily="monospace"
                android:layout_marginRight="4dp" />

            <Button
                android:id="@+id/btn_toolbox"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="@string/btn_toolbox"
                android:textSize="11sp"
                android:textColor="@color/accent_green"
                android:background="@color/bg_btn"
                android:fontFamily="monospace"
                android:layout_marginRight="4dp" />

            <Button
                android:id="@+id/btn_scripts"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="@string/btn_scripts"
                android:textSize="11sp"
                android:textColor="@color/accent_purple"
                android:background="@color/bg_btn"
                android:fontFamily="monospace"
                android:layout_marginRight="4dp" />

            <Button
                android:id="@+id/btn_cheatsheet"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="@string/btn_cheatsheet"
                android:textSize="11sp"
                android:textColor="@color/accent_yellow"
                android:background="@color/bg_btn"
                android:fontFamily="monospace"
                android:layout_marginRight="4dp" />

            <Button
                android:id="@+id/btn_status"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="@string/btn_sys"
                android:textSize="11sp"
                android:textColor="@color/btn_text"
                android:background="@color/bg_btn"
                android:fontFamily="monospace"
                android:layout_marginRight="4dp" />

            <Button
                android:id="@+id/btn_settings"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="@string/btn_settings"
                android:textSize="11sp"
                android:textColor="@color/btn_text"
                android:background="@color/bg_btn"
                android:fontFamily="monospace"
                android:layout_marginRight="4dp" />

            <Button
                android:id="@+id/btn_clear"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="@string/btn_clear"
                android:textSize="11sp"
                android:textColor="@color/btn_text"
                android:background="@color/bg_btn"
                android:fontFamily="monospace" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Session Tab Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:orientation="horizontal"
        android:background="#12161C"
        android:gravity="center_vertical"
        android:paddingLeft="6dp"
        android:paddingRight="6dp">

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/tab_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical" />
        </HorizontalScrollView>

        <Button
            android:id="@+id/btn_add_tab"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:text="@string/btn_new_tab"
            android:textSize="11sp"
            android:textColor="@color/accent_blue"
            android:background="@color/bg_btn"
            android:fontFamily="monospace"
            android:minWidth="54dp" />
    </LinearLayout>

    <!-- Terminal Display Output -->
    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:fillViewport="true"
        android:background="@color/bg_terminal_surface">

        <TextView
            android:id="@+id/term_output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/term_text"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:lineSpacingExtra="2dp" />
    </ScrollView>

    <!-- Virtual Keyboard Modifier Bar -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="@color/bg_bar"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layout_extra_keys"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="6dp"
            android:paddingRight="6dp">

            <Button
                android:id="@+id/btn_key_ctrl_c"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="^C"
                android:textSize="11sp"
                android:textColor="@color/accent_red"
                android:background="@color/bg_btn"
                android:fontFamily="monospace"
                android:minWidth="38dp"
                android:layout_marginRight="3dp" />

            <Button
                android:id="@+id/btn_key_ctrl_d"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="^D"
                android:textSize="11sp"
                android:textColor="@color/accent_yellow"
                android:background="@color/bg_btn"
                android:fontFamily="monospace"
                android:minWidth="38dp"
                android:layout_marginRight="3dp" />

            <Button
                android:id="@+id/btn_key_tab"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="TAB"
                android:textSize="11sp"
                android:textColor="@color/btn_text"
                android:background="@color/bg_btn"
                android:fontFamily="monospace"
                android:minWidth="40dp"
                android:layout_marginRight="3dp" />

            <Button
                android:id="@+id/btn_key_esc"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="ESC"
                android:textSize="11sp"
                android:textColor="@color/btn_text"
                android:background="@color/bg_btn"
                android:fontFamily="monospace"
                android:minWidth="40dp"
                android:layout_marginRight="3dp" />

            <Button
                android:id="@+id/btn_key_pipe"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="|"
                android:textSize="12sp"
                android:textColor="@color/accent_blue"
                android:background="@color/bg_btn"
                android:fontFamily="monospace"
                android:minWidth="32dp"
                android:layout_marginRight="3dp" />

            <Button
                android:id="@+id/btn_key_amp"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="&amp;"
                android:textSize="12sp"
                android:textColor="@color/accent_blue"
                android:background="@color/bg_btn"
                android:fontFamily="monospace"
                android:minWidth="32dp"
                android:layout_marginRight="3dp" />

            <Button
                android:id="@+id/btn_key_tilde"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="~"
                android:textSize="12sp"
                android:textColor="@color/btn_text"
                android:background="@color/bg_btn"
                android:fontFamily="monospace"
                android:minWidth="32dp"
                android:layout_marginRight="3dp" />

            <Button
                android:id="@+id/btn_key_slash"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="/"
                android:textSize="12sp"
                android:textColor="@color/btn_text"
                android:background="@color/bg_btn"
                android:fontFamily="monospace"
                android:minWidth="32dp"
                android:layout_marginRight="3dp" />

            <Button
                android:id="@+id/btn_key_dash"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="-"
                android:textSize="12sp"
                android:textColor="@color/btn_text"
                android:background="@color/bg_btn"
                android:fontFamily="monospace"
                android:minWidth="32dp"
                android:layout_marginRight="3dp" />

            <Button
                android:id="@+id/btn_key_gt"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text=">"
                android:textSize="12sp"
                android:textColor="@color/btn_text"
                android:background="@color/bg_btn"
                android:fontFamily="monospace"
                android:minWidth="32dp"
                android:layout_marginRight="3dp" />

            <Button
                android:id="@+id/btn_key_quote"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="&quot;"
                android:textSize="12sp"
                android:textColor="@color/btn_text"
                android:background="@color/bg_btn"
                android:fontFamily="monospace"
                android:minWidth="32dp"
                android:layout_marginRight="3dp" />

            <Button
                android:id="@+id/btn_key_up"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="UP"
                android:textSize="11sp"
                android:textColor="@color/btn_text"
                android:background="@color/bg_btn"
                android:fontFamily="monospace"
                android:minWidth="36dp"
                android:layout_marginRight="3dp" />

            <Button
                android:id="@+id/btn_key_down"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="DOWN"
                android:textSize="11sp"
                android:textColor="@color/btn_text"
                android:background="@color/bg_btn"
                android:fontFamily="monospace"
                android:minWidth="44dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Command Input Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="@color/bg_bar"
        android:gravity="center_vertical"
        android:paddingLeft="8dp"
        android:paddingRight="8dp">

        <TextView
            android:id="@+id/tv_prompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$ "
            android:textColor="@color/accent_green"
            android:textStyle="bold"
            android:textSize="14sp"
            android:fontFamily="monospace" />

        <EditText
            android:id="@+id/term_input"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@color/bg_terminal"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:singleLine="true"
            android:imeOptions="actionDone"
            android:hint="@string/hint_input"
            android:textColorHint="#484F58" />

        <Button
            android:id="@+id/btn_send"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/btn_run"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:background="@color/accent_green"
            android:fontFamily="monospace"
            android:minWidth="52dp"
            android:layout_marginLeft="6dp" />
    </LinearLayout>

</LinearLayout>
